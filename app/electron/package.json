{
    "name":  "estudiantil",
    "version":  "1.0.0",
    "description":  "SINEVA",
    "author":  "Master\u0027s Corporation",
    "main":  "main.js",
    "private":  true,
    "devDependencies":  {
                            "electron":  "45.2.3",
                            "electron-builder":  "26.18.0"
                        },
    "build":  {
                  "appId":  "com.masters.estudiantil",
                  "productName":  "SINEVA",
                  "artifactName":  "SINEVA-Setup.${ext}",
                  "directories":  {
                                      "output":  "dist",
                                      "buildResources":  "."
                                  },
                  "files":  [
                                "main.js",
                                "offline.html",
                                "actualizando.html",
                                "icon.png"
                            ],
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ],
                              "icon":  "icon.png"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "perMachine":  false,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "shortcutName":  "SINEVA",
                               "language":  "3082"
                           },
                  "publish":  [
                                  {
                                      "provider":  "generic",
                                      "url":  "https://github.com/bell-geordi-rojas/sistema_estudiantil/releases/download/app-latest"
                                  }
                              ]
              },
    "dependencies":  {
                         "electron-updater":  "6.8.11"
                     }
}
